{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/smart-recovery-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // Connection string para o PostgreSQL rodando via Docker Compose.
    // Em desenvolvimento local, use o arquivo appsettings.Development.json para sobrescrever.
    "DefaultConnection": "Host=postgres;Port=5432;Database=smart_recovery;Username=admin;Password=admin123"
  },
  "Security": {
    // Vazio de propósito — em produção é definido via variável de ambiente Security__ApiKey.
    // Se ficar vazio, o ApiKeyMiddleware não exige a chave (ver comentário na própria classe).
    "ApiKey": ""
  },
  "Cors": {
    // Domínios padrão do Firebase Hosting para este projeto (smart-recovery-8b538). Se um domínio
    // customizado for configurado no Firebase, adicione aqui também.
    "AllowedOrigins": [
      "https://smart-recovery-8b538.web.app",
      "https://smart-recovery-8b538.firebaseapp.com"
    ]
  },
  "SmartRecovery": {
    "PaymentRetryWorker": {
      // Intervalo em segundos em que o Background Worker verifica pagamentos pendentes de retry
      "IntervalSeconds": 60
    }
  }
}
